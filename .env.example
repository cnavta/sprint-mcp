# Environment Variables for LLM-Powered AGENTS.md Compression System

# ============================================================================
# REQUIRED: Anthropic API Key
# ============================================================================
# This API key is required for all LLM integration (Semantic Extractor,
# Compression Engine, Validation Engine).
#
# How to obtain:
# 1. Go to https://console.anthropic.com/settings/keys
# 2. Create a new API key
# 3. Copy the key and set it below
#
# Usage:
# - Copy this file to .env or .secrets
# - Replace the placeholder with your actual API key
# - Load before running: source .env or source .secrets
# ============================================================================

ANTHROPIC_API_KEY=your-api-key-here

# ============================================================================
# OPTIONAL: Configuration Overrides
# ============================================================================
# These are optional and have sensible defaults in the code

# COMPRESSION_CONFIG_PATH=config/compression-config.json
# SEMANTIC_INVARIANTS_PATH=semantic-invariants.json
# SOURCE_DOCUMENT=AGENTS-uncompressed.md
# OUTPUT_DOCUMENT=AGENTS.md
