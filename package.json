{
  "name": "sprint-mcp",
  "version": "0.1.0",
  "description": "MCP server providing Sprint Protocol tooling for LLM-driven development workflows",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sprint-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "dev": "npm run build && node dist/index.js",
    "sprint:index:regenerate": "npm run build && node -e \"import('./dist/common/sprint-index-manager.js').then(m => m.regenerateSprintIndex().then(() => console.log('✅ Sprint index regenerated successfully')))\"",
    "sprint:cleanup": "npm run build && node scripts/sprint-cleanup.js",
    "compress:extract": "npx tsx src/compression/cli.ts extract",
    "compress:agents": "npx tsx src/compression/cli.ts compress",
    "compress:validate": "npx tsx src/compression/cli.ts validate",
    "compress:all": "npm run compress:extract && npm run compress:agents && npm run compress:validate",
    "release": "node scripts/release.js",
    "release:dry": "node scripts/release.js --dry-run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sprint",
    "llm",
    "development-workflow",
    "agent-tooling"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.27",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ai": "^7.0.47",
    "commander": "^15.0.0",
    "js-yaml": "^5.2.2",
    "yaml": "^2.3.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
